# AgentThreads — copy to .env and fill in real values. Never commit .env itself.

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_KEY_ID=
SUPABASE_JWT_PREVIOUS_KEY_ID=
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=agentthreads-media

# ── NVIDIA NIM ───────────────────────────────────────────────────────────
# Comma-separated pool (up to 6) for load distribution; NVIDIA_NIM_API_KEY is a
# single-key fallback if you only have one.
NVIDIA_NIM_API_KEYS=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
MCP_PORT=8081
APP_ENV=development

# ── AgentReplay webhook ──────────────────────────────────────────────────
AGENTREPLAY_WEBHOOK_SECRET=

# ── App URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080
